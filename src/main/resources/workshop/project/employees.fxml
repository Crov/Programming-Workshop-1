<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="950.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="workshop.project.alexander.EmployeesController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Employee Management">
            <font>
                <Font name="Segoe UI Bold" size="24.0" />
            </font>
        </Label>
        <fx:define>
            <ToggleGroup fx:id="genderGroup" />
        </fx:define>
        <GridPane alignment="CENTER" hgap="15.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="-Infinity" minWidth="80.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.0" minWidth="150.0" />
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="-Infinity" minWidth="80.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="250.0" minWidth="150.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <font><Font name="Segoe UI" size="14.0" /></font>
                </Label>
                <TextField fx:id="nameField" promptText="Enter full name" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <font><Font name="Segoe UI" size="14.0" /></font>
                </Label>
                <TextField fx:id="emailField" promptText="Enter email address" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                <Label text="DOB:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <font><Font name="Segoe UI" size="14.0" /></font>
                </Label>
                <DatePicker fx:id="datePicker" prefWidth="250.0" promptText="Select Date of Birth" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Gender:" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <font><Font name="Segoe UI" size="14.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="15.0" GridPane.columnIndex="3" GridPane.rowIndex="1">
                    <children>
                        <RadioButton fx:id="maleRadio" mnemonicParsing="false" selected="true" text="Male" toggleGroup="$genderGroup" />
                        <RadioButton fx:id="femaleRadio" mnemonicParsing="false" text="Female" toggleGroup="$genderGroup" />
                    </children>
                </HBox>
                <Label text="Dept:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <font><Font name="Segoe UI" size="14.0" /></font>
                </Label>
                <ChoiceBox fx:id="departmentBox" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Salary:" GridPane.columnIndex="2" GridPane.rowIndex="2">
                    <font><Font name="Segoe UI" size="14.0" /></font>
                </Label>
                <TextField fx:id="salaryField" promptText="Enter salary" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <font><Font name="Segoe UI" size="14.0" /></font>
                </Label>
                <TextField fx:id="phoneField" promptText="Enter phone number" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Full Time:" GridPane.columnIndex="2" GridPane.rowIndex="3">
                    <font><Font name="Segoe UI" size="14.0" /></font>
                </Label>
                <CheckBox fx:id="fulltimeCheckBox" mnemonicParsing="false" selected="true" text="Yes" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            </children>
        </GridPane>
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#addEmployee" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add Employee">
                    <font><Font name="Segoe UI Bold" size="13.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#updateEmployee" prefWidth="120.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Update Selected">
                    <font><Font name="Segoe UI Bold" size="13.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#deleteEmployee" prefWidth="120.0" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Delete Selected">
                    <font><Font name="Segoe UI Bold" size="13.0" /></font>
                </Button>
            </children>
            <VBox.margin>
                <Insets bottom="5.0" top="5.0" />
            </VBox.margin>
        </HBox>
        <Label fx:id="formMessage" text=" ">
            <font>
                <Font name="Segoe UI Bold" size="14.0" />
            </font>
        </Label>
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameCol" prefWidth="150.0" text="Name" />
                <TableColumn fx:id="emailCol" prefWidth="180.0" text="Email" />
                <TableColumn fx:id="dobCol" prefWidth="100.0" text="DOB" />
                <TableColumn fx:id="genderCol" prefWidth="75.0" text="Gender" />
                <TableColumn fx:id="deptCol" prefWidth="120.0" text="Department" />
                <TableColumn fx:id="salaryCol" prefWidth="90.0" text="Salary" />
                <TableColumn fx:id="phoneCol" prefWidth="120.0" text="Phone" />
                <TableColumn fx:id="fulltimeCol" prefWidth="75.0" text="Full Time" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>