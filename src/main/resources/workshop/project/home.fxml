<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="workshop.project.HomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="welcomeLabel" text="Loading Dashboard...">
            <font>
                <Font name="Segoe UI Bold" size="24.0" />
            </font>
        </Label>
        <Label text="Please select an entity to manage:" textFill="#555555">
            <font>
                <Font name="Segoe UI" size="14.0" />
            </font>
        </Label>
        <Button fx:id="booksButton" mnemonicParsing="false" onAction="#openBooks" prefHeight="40.0" prefWidth="200.0" text="Manage Books">
                <font>
                    <Font name="Segoe UI" size="14.0" />
                </font>
        </Button>
        <Button fx:id="employeesButton" mnemonicParsing="false" onAction="#openEmployees" prefHeight="40.0" prefWidth="200.0" text="Manage Employees">
            <font>
                <Font name="Segoe UI" size="14.0" />
            </font>
        </Button>
    </children>
</VBox>